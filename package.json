{
  "name": "intelly-gestor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "tsx scripts/bootstrap-build.ts",
    "build": "next build",
    "start": "tsx scripts/start-production.ts",
    "lint": "oxlint . --deny-warnings",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:legacy-render": "node --test tests/deployment-config.test.mjs tests/rendered-html.test.mjs",
    "pdf:sample": "tsx scripts/generate-sample-pdf.ts",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed-admin": "tsx scripts/seed-admin.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "latest",
    "@tailwindcss/postcss": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "drizzle-orm": "latest",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "latest",
    "mysql2": "latest",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "recharts": "latest",
    "server-only": "latest",
    "tailwindcss": "latest",
    "tsx": "latest",
    "typescript": "7.0.2",
    "zod": "latest"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "drizzle-kit": "latest",
    "oxlint": "^1.78.0",
    "vitest": "latest"
  }
}
